# ─────────────────────────────────────────────────────────────
# Grover Tex Prints — Task Manager  |  environment config
# ─────────────────────────────────────────────────────────────
# Is file ko copy karke `.env` banao aur values bharo:
#     cp .env.example .env
# `.env` git me kabhi NAHI jaata (.gitignore me hai). Sirf ye example file
# commit hoti hai, taaki pata rahe kaun-kaun se vars chahiye.

# ── DATABASE (MySQL 8 / MariaDB — Hostinger dono deta hai) ────
DB_KIND=mysql

# Option A — Hostinger (hPanel → Websites → Databases → Management)
#   "MySQL host"     → DB_HOST     (Hostinger par 127.0.0.1; bahar se srvNNNN.hstgr.io jaisa)
#   "Database name"  → DB_NAME     (u123456789_grover jaisa)
#   "Username"       → DB_USER     (u123456789_grover jaisa)
#   password         → DB_PASSWORD
# App Hostinger par hi chal rahi ho to DB_HOST=127.0.0.1 rakho (hPanel yahi dikhata hai).
# Apne laptop se Hostinger DB par connect karna ho to hPanel → Databases →
# Remote MySQL me apna IP add karo aur DB_HOST me wahi hstgr.io wala host daalo.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Option B — ek hi line me (Railway/PlanetScale style). Bhari ho to upar ke
# DB_* ignore ho jaate hain:
#   DATABASE_URL=mysql://user:pass@host:3306/dbname
DATABASE_URL=

# Connection pool size (default 10; Hostinger shared par 5 kaafi hai)
DB_POOL_MAX=5

# ── APP ───────────────────────────────────────────────────────
NODE_ENV=production
# Hostinger Node.js app apna PORT khud deta hai — wahan ye khaali chhod do.
PORT=3000
# Login token sign karne ka secret — lamba random string (min 32 chars).
# Banane ke liye:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Public URL (email/WhatsApp links isi se bante hain), e.g. https://tasks.grovertex.com
APP_URL=

# ── PEHLA ADMIN (npm run db:seed-admin) ───────────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── CRON (sirf Vercel serverless par lagta hai; Hostinger par ignore) ──
CRON_SECRET=

# ── OPTIONAL: Google Drive / Apps Script uploads ──────────────
APPS_SCRIPT_UPLOAD_URL=
APPS_SCRIPT_SECRET=
GDRIVE_VIDEO_FOLDER_ID=
GDRIVE_FMS_FOLDER_ID=
# Service account JSON — ya to seedha JSON, ya base64 (ek chuno)
GOOGLE_CREDENTIALS=
GOOGLE_CREDENTIALS_B64=

# ── OPTIONAL: Email (Gmail SMTP — App Password chahiye) ───────
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=

# ── OPTIONAL: WhatsApp (Waumfy) ───────────────────────────────
WAUMFY_API_KEY=
WAUMFY_TRIGGER_URL=
WAUMFY_DOC_TRIGGER_URL=
WAUMFY_IMAGE_TRIGGER_URL=
WA_SCHEDULER_ENABLED=false
